{
  "manifest_version": 3,
  "name": "启动助手 · B站专注",
  "version": "1.0.0",
  "description": "与本机启动助手连接，仅在主动专注期间允许事先选择的 B 站视频。",
  "permissions": ["storage", "alarms", "tabs", "scripting", "declarativeNetRequest"],
  "host_permissions": ["http://127.0.0.1/*", "*://*.bilibili.com/*", "*://bilibili.com/*", "*://b23.tv/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "启动助手 · 配对与导入视频"},
  "options_page": "options.html",
  "content_scripts": [{"matches": ["*://*.bilibili.com/*", "*://bilibili.com/*", "*://b23.tv/*"], "js": ["content.js"], "run_at": "document_start"}],
  "web_accessible_resources": [{"resources": ["blocked.html", "blocked.js", "style.css"], "matches": ["<all_urls>"]}]
}
